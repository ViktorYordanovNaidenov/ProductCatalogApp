<Window x:Class="ProductCatalogApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог на продукти" Height="500" Width="700"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ляв панел за CRUD операции -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Име на продукт:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtName" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Цена (лв.):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPrice" Margin="0,0,0,20" Padding="5"/>

            <Button Content="Добави" Click="BtnAdd_Click" Margin="0,0,0,5" Padding="5" Background="#10B981" Foreground="White"/>
            <Button Content="Запиши промените" Click="BtnUpdate_Click" Margin="0,0,0,5" Padding="5" Background="#3B82F6" Foreground="White"/>
            <Button Content="Изтрий" Click="BtnDelete_Click" Margin="0,0,0,20" Padding="5" Background="#EF4444" Foreground="White"/>

            <TextBlock x:Name="txtStatus" TextWrapping="Wrap" Foreground="#4B5563" FontStyle="Italic"/>
        </StackPanel>

        <!-- Десен панел за търсене и визуализация -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панел за филтриране[cite: 3] -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Grid.Column="0" Margin="0,0,10,0" Padding="5" />
                <Button x:Name="btnSearch" Grid.Column="1" Content="Търси" Click="BtnSearch_Click" Padding="5"/>
            </Grid>

            <!-- Таблица с резултати -->
            <DataGrid x:Name="gridProducts" Grid.Row="1" AutoGenerateColumns="True" 
                      IsReadOnly="True" SelectionChanged="GridProducts_SelectionChanged"/>
        </Grid>
    </Grid>
</Window>